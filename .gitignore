# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
/src/VehicleMovement/[Ll]ibrary/
/src/VehicleMovement/[Tt]emp/
/src/VehicleMovement/[Oo]bj/
/src/VehicleMovement/[Bb]uild/
/src/VehicleMovement/[Bb]uilds/
/src/VehicleMovement/[Ll]ogs/
/src/VehicleMovement/[Uu]ser[Ss]ettings/

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/src/VehicleMovement/[Mm]emoryCaptures/

# Recordings can get excessive in size
/src/VehicleMovement/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /src/VehicleMovement/[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/src/VehicleMovement/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
/src/VehicleMovement/.vs/
/src/VehicleMovement/.idea
.idea/
/src/VehicleMovement/.idea/

# Gradle cache directory
/src/VehicleMovement/.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
/src/VehicleMovement/sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app


# Crashlytics generated file
/src/VehicleMovement/crashlytics-build.properties

# Packed Addressables
/src/VehicleMovement/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/src/VehicleMovement/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/link.xml
/src/VehicleMovement/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/link.xml.meta
/src/VehicleMovement/ServerData/*


# Temporary auto-generated Android Assets
/src/VehicleMovement/[Aa]ssets/[Ss]treamingAssets/aa.meta
/src/VehicleMovement/[Aa]ssets/[Ss]treamingAssets/aa/*